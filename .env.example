# ⚠ VITE_ 접두사가 붙은 값은 프론트엔드 번들에 그대로 박혀 브라우저로 나간다.
#   서비스 롤 키·관리자 토큰을 여기에 두지 마라 (서버 전용 키는 Supabase 함수 시크릿으로).
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=<your_anon_key>
VITE_GEMINI_API_KEY=<your_gemini_api_key>

# DEV 테이블 모드 (로컬 테스트 전용): true면 -dev 슬러그 함수 + dev_ 테이블 사용, 프로덕션 테이블 무접촉
VITE_DEV_TABLES=false
